{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shorts-harness.local/schemas/episode.schema.json",
  "title": "Shorts Harness episode timing and editor-delivery contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "episodeId",
    "version",
    "fps",
    "width",
    "height",
    "narration",
    "syncToleranceMs",
    "totalFrames",
    "shots",
    "exports"
  ],
  "properties": {
    "episodeId": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "fps": {
      "enum": [30, 24]
    },
    "width": {
      "const": 1080
    },
    "height": {
      "const": 1920
    },
    "narration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assetId",
        "durationMs",
        "syncSource"
      ],
      "properties": {
        "assetId": {
          "type": "string",
          "minLength": 1
        },
        "sourceFile": {
          "type": "string",
          "minLength": 1
        },
        "durationMs": {
          "type": "integer",
          "minimum": 1
        },
        "syncSource": {
          "const": "measured-audio"
        },
        "voiceModel": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "syncToleranceMs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 250
    },
    "totalFrames": {
      "type": "integer",
      "minimum": 1
    },
    "shots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "shotId",
          "startFrame",
          "endFrame",
          "narrationStartMs",
          "narrationEndMs",
          "narrationSegments",
          "visual",
          "characters",
          "characterMotion",
          "camera",
          "captions",
          "transition",
          "assets",
          "audio"
        ],
        "properties": {
          "shotId": {
            "type": "string",
            "minLength": 1
          },
          "startFrame": {
            "type": "integer",
            "minimum": 0
          },
          "endFrame": {
            "type": "integer",
            "minimum": 1
          },
          "narrationStartMs": {
            "type": "integer",
            "minimum": 0
          },
          "narrationEndMs": {
            "type": "integer",
            "minimum": 1
          },
          "narrationSegments": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "text",
                "startMs",
                "endMs"
              ],
              "properties": {
                "text": {
                  "type": "string",
                  "minLength": 1
                },
                "startMs": {
                  "type": "integer",
                  "minimum": 0
                },
                "endMs": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          },
          "visual": {
            "type": "string",
            "minLength": 1
          },
          "characters": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "characterId",
                "poseId",
                "action"
              ],
              "properties": {
                "characterId": {
                  "type": "string",
                  "minLength": 1
                },
                "poseId": {
                  "type": "string",
                  "minLength": 1
                },
                "action": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "characterMotion": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "poseFps",
              "exposureFrames",
              "action"
            ],
            "properties": {
              "poseFps": {
                "enum": [15, 12]
              },
              "exposureFrames": {
                "const": 2
              },
              "action": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "camera": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "description",
              "fps"
            ],
            "properties": {
              "description": {
                "type": "string",
                "minLength": 1
              },
              "fps": {
                "enum": [30, 24]
              }
            }
          },
          "captions": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "text",
                "startFrame",
                "endFrame",
                "position"
              ],
              "properties": {
                "text": {
                  "type": "string",
                  "minLength": 1
                },
                "startFrame": {
                  "type": "integer",
                  "minimum": 0
                },
                "endFrame": {
                  "type": "integer",
                  "minimum": 1
                },
                "position": {
                  "enum": [
                    "top",
                    "center",
                    "bottom"
                  ]
                },
                "styleId": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "transition": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "in",
              "out"
            ],
            "properties": {
              "in": {
                "type": "string",
                "minLength": 1
              },
              "out": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "assets": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "audio": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "assetId",
                "startMs",
                "endMs",
                "kind"
              ],
              "properties": {
                "assetId": {
                  "type": "string",
                  "minLength": 1
                },
                "startMs": {
                  "type": "integer",
                  "minimum": 0
                },
                "endMs": {
                  "type": "integer",
                  "minimum": 1
                },
                "kind": {
                  "enum": [
                    "narration",
                    "sfx",
                    "music",
                    "ambience"
                  ]
                },
                "sourceFile": {
                  "type": "string",
                  "minLength": 1
                },
                "syncNote": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    },
    "exports": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "preview",
        "scenes"
      ],
      "properties": {
        "preview": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "filename",
            "format",
            "includesBurnedCaptions"
          ],
          "properties": {
            "filename": {
              "type": "string",
              "minLength": 1
            },
            "format": {
              "const": "mp4"
            },
            "includesBurnedCaptions": {
              "type": "boolean"
            }
          }
        },
        "scenes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "shotId",
              "filename",
              "format",
              "width",
              "height",
              "fps"
            ],
            "properties": {
              "shotId": {
                "type": "string",
                "minLength": 1
              },
              "filename": {
                "type": "string",
                "minLength": 1
              },
              "format": {
                "const": "mp4"
              },
              "width": {
                "const": 1080
              },
              "height": {
                "const": 1920
              },
              "fps": {
                "enum": [30, 24]
              }
            }
          }
        }
      }
    }
  }
}
